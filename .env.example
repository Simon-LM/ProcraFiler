# ProcraFiler runtime environment template
#
# Copy this file to one of:
# - the project root as `.env` (auto-loaded when you run from the repo; good for dev)
# - ~/.config/procrafiler/procrafiler.env (recommended for a user install)
# - /etc/procrafiler/procrafiler.env (recommended for a system install)
# Then fill the values you need. Real env files are gitignored — never commit keys.

# Optional runtime path overrides. Leave unset to use the defaults under $HOME.
# (The dev sandbox does NOT rely on these — sandbox/run.sh forces its own paths
# inside sandbox/workspace/, so testing never touches your real Downloads or home.)
# PROCRAFILER_WORKSPACE_DIR=/home/you/Downloads/ProcraFiler_Inbox
# PROCRAFILER_LIBRARY_DIR=/home/you/ProcraFiler_Library
# PROCRAFILER_LIBRARY_MIRROR_DIR=/home/you/ProcraFiler_Library_Mirror
# PROCRAFILER_HOME=/home/you/.local/share/procrafiler
# PROCRAFILER_CONFIG_HOME=/home/you/.config/procrafiler

# ===========================================================================
# AI providers — WHICH AI reads & classifies your documents. YOU choose, here.
# Full guide (tested models + VRAM tiers): docs/ai-providers.md
#
# Format per task:  PROCRAFILER_AI_<TASK>_PRIMARY = provider:model
#   providers:  mistral  (API — needs MISTRAL_API_KEY)   ·   ollama  (local)
#   add ",provider:model" for a fallback · empty = that task → manual review
#
# DEFAULT below = Mistral API: simplest & most reliable — just set MISTRAL_API_KEY.
# `procrafiler setup` can write the API or the all-local preset for you.
#
# To run everything LOCALLY instead (free, offline, but slower), replace the four
# *_PRIMARY lines below with these — pick models for YOUR VRAM in docs/ai-providers.md.
# Local (ollama) calls get a generous timeout AUTOMATICALLY (slow inference), so you
# don't need to set one — the timeouts below stay moderate for the fast Mistral API.
#   PROCRAFILER_AI_ANALYSIS_PRIMARY=ollama:qwen3.5:9b
# NAMING — re-judges the names of a whole dropped FOLDER at once, after every file
# has been analysed. Catches a file (typically a photo) misnamed from its own
# content by weighing it against the folder and its neighbours. Folder drops only.
PROCRAFILER_AI_NAMING_PRIMARY=mistral:mistral-medium-latest
# PROCRAFILER_AI_NAMING_FALLBACK=

#   PROCRAFILER_AI_ORGANIZE_PRIMARY=ollama:gemma4:12b
#   PROCRAFILER_AI_OCR_PRIMARY=ollama:minicpm-v
#   PROCRAFILER_AI_IMAGE_PRIMARY=ollama:qwen2.5vl:7b
# ===========================================================================

# ANALYSIS — one call that reads the content and returns the whole fiche (name,
# date, category + alternatives, summary, keywords, entities). (USED)
# Tested: mistral-small-latest (API) · ollama:qwen3.5:9b (local — fits 12GB, ~87s)
PROCRAFILER_AI_ANALYSIS_PRIMARY=mistral:mistral-small-latest
PROCRAFILER_AI_ANALYSIS_FALLBACK=

# ORGANIZE — set-aware: groups a folder dropped as a set into dated affair/series
# folders. Empty = no grouping (each file keeps its per-file category). (USED)
# Tested: mistral-medium-latest (API) · ollama:gemma4:12b (local, experimental)
PROCRAFILER_AI_ORGANIZE_PRIMARY=mistral:mistral-medium-latest
PROCRAFILER_AI_ORGANIZE_FALLBACK=

# OCR — read scanned / image-only PDFs (no text layer). (USED)
# Keep "-latest" to get the newest Mistral OCR automatically. local: ollama:minicpm-v
PROCRAFILER_AI_OCR_PRIMARY=mistral:mistral-ocr-latest
PROCRAFILER_AI_OCR_FALLBACK=

# IMAGE — read images with a vision model. (USED)
# Tested: mistral-medium-latest (API) · ollama:qwen2.5vl:7b (local)
PROCRAFILER_AI_IMAGE_PRIMARY=mistral:mistral-medium-latest
PROCRAFILER_AI_IMAGE_FALLBACK=

# Reserved for later — not consulted by the current code:
# PDF readable files are read locally (pypdf), so no PDF AI task is needed today.
PROCRAFILER_AI_PDF_PRIMARY=
PROCRAFILER_AI_PDF_FALLBACK=
# SUPERVISOR (optional AI control pass) — not implemented yet.
PROCRAFILER_AI_SUPERVISOR_PRIMARY=
PROCRAFILER_AI_SUPERVISOR_FALLBACK=
# TRANSCRIBE — speech to text for audio files AND the audio track of videos. (USED)
# Billed per SECOND of recording, which is why listening is the cheap first read.
# Ollama has no transcription endpoint, so this task is Mistral-only today.
PROCRAFILER_AI_TRANSCRIBE_PRIMARY=mistral:voxtral-mini-latest
PROCRAFILER_AI_TRANSCRIBE_FALLBACK=

# VIDEO — reads a transcript and picks the moments worth a still image. (USED)
# Text-only and short, so the small model is plenty. With no chain here the stills
# are simply spread evenly instead of chosen — cheaper, less precise.
PROCRAFILER_AI_VIDEO_PRIMARY=mistral:mistral-small-latest
PROCRAFILER_AI_VIDEO_FALLBACK=

# How much of a long recording is transcribed. Guards against a forgotten 4-hour
# file quietly becoming the most expensive thing you ever dropped in. Default 2700
# (45 min); the rest is skipped and reported, never silently paid for.
# PROCRAFILER_MAX_TRANSCRIBE_SECONDS=2700

# Retry / timeout defaults (seconds). Timeouts are PROVIDER-AWARE — two knobs:
#   PROCRAFILER_AI_TIMEOUT        → the API (Mistral) timeout (fast → moderate).
#   PROCRAFILER_AI_LOCAL_TIMEOUT  → the local (Ollama) timeout (slow → generous;
#                                   defaults to 900s automatically, so usually leave unset).
PROCRAFILER_AI_TIMEOUT=60
# PROCRAFILER_AI_LOCAL_TIMEOUT=900
PROCRAFILER_AI_RETRIES=2

# Optional per-task overrides (apply to whichever provider runs that task — so don't
# pin a short ANALYSIS timeout if you run that task locally):
# PROCRAFILER_AI_ANALYSIS_TIMEOUT=60
PROCRAFILER_AI_ANALYSIS_RETRIES=2

# Mistral API key (required when any chain uses the mistral provider)
MISTRAL_API_KEY=
