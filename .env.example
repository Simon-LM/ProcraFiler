# ProcraFiler runtime environment template
# Copy this file to one of:
# - ~/.config/procrafiler/procrafiler.env (recommended for user mode)
# - /etc/procrafiler/procrafiler.env (recommended for system mode)
# Then fill the values you need.

# Optional runtime path overrides
# PROCRAFILER_WORKSPACE_DIR=/home/you/Downloads/ProcraFiler_Inbox
# PROCRAFILER_LIBRARY_DIR=/home/you/ProcraFiler_Library
# PROCRAFILER_LIBRARY_MIRROR_DIR=/home/you/ProcraFiler_Library_Mirror
# PROCRAFILER_HOME=/home/you/.local/share/procrafiler
# PROCRAFILER_CONFIG_HOME=/home/you/.config/procrafiler

# Per-task AI chains (provider:model,provider:model)
# Primary chain is attempted first. Fallback chain is attempted after primary exhaustion.
# Examples:
#   PROCRAFILER_AI_NAMING_PRIMARY=mistral:mistral-small-2506
#   PROCRAFILER_AI_NAMING_FALLBACK=ollama:mistral
PROCRAFILER_AI_NAMING_PRIMARY=
PROCRAFILER_AI_NAMING_FALLBACK=
PROCRAFILER_AI_OCR_PRIMARY=
PROCRAFILER_AI_OCR_FALLBACK=
PROCRAFILER_AI_PDF_PRIMARY=
PROCRAFILER_AI_PDF_FALLBACK=
PROCRAFILER_AI_IMAGE_PRIMARY=
PROCRAFILER_AI_IMAGE_FALLBACK=
PROCRAFILER_AI_VIDEO_PRIMARY=
PROCRAFILER_AI_VIDEO_FALLBACK=
PROCRAFILER_AI_SUPERVISOR_PRIMARY=
PROCRAFILER_AI_SUPERVISOR_FALLBACK=
PROCRAFILER_AI_CLASSIFICATION_PRIMARY=
PROCRAFILER_AI_CLASSIFICATION_FALLBACK=

# Retry and timeout defaults
PROCRAFILER_AI_TIMEOUT=60
PROCRAFILER_AI_RETRIES=2

# Optional task-specific overrides
PROCRAFILER_AI_NAMING_TIMEOUT=60
PROCRAFILER_AI_NAMING_RETRIES=2

# Mistral API key (required if mistral provider is used)
MISTRAL_API_KEY=
