# ProcraFiler runtime environment template
#
# Copy this file to one of:
# - the project root as `.env` (auto-loaded when you run from the repo; good for dev)
# - ~/.config/procrafiler/procrafiler.env (recommended for a user install)
# - /etc/procrafiler/procrafiler.env (recommended for a system install)
# Then fill the values you need. Real env files are gitignored — never commit keys.

# Optional runtime path overrides. Leave unset to use the defaults under $HOME.
# (The dev sandbox sets these to point entirely inside sandbox/, so testing never
# touches your real Downloads or home.)
# PROCRAFILER_WORKSPACE_DIR=/home/you/Downloads/ProcraFiler_Inbox
# PROCRAFILER_LIBRARY_DIR=/home/you/ProcraFiler_Library
# PROCRAFILER_LIBRARY_MIRROR_DIR=/home/you/ProcraFiler_Library_Mirror
# PROCRAFILER_HOME=/home/you/.local/share/procrafiler
# PROCRAFILER_CONFIG_HOME=/home/you/.config/procrafiler

# ---------------------------------------------------------------------------
# Per-task AI chains: provider:model[,provider:model...]
# Primary is tried first, fallback after the primary chain is exhausted.
# The provider/model is never hardcoded in the app — you choose it here.
# With a task left empty, files that would need it route to manual review.
# Supported providers: mistral (API key), ollama (local, http://localhost:11434).
# ---------------------------------------------------------------------------

# ANALYSIS — one call that reads the content and returns the whole fiche:
# the new filename, the document date, the category (+ alternatives), a summary,
# keywords, and entities. Replaces the former separate NAMING + CLASSIFICATION
# tasks (one read, one call). (USED)
PROCRAFILER_AI_ANALYSIS_PRIMARY=mistral:mistral-small-latest
PROCRAFILER_AI_ANALYSIS_FALLBACK=

# OCR — read scanned / image-only PDFs (no text layer). (USED)
PROCRAFILER_AI_OCR_PRIMARY=mistral:mistral-ocr-latest
PROCRAFILER_AI_OCR_FALLBACK=

# IMAGE — read images with a vision model. (USED)
PROCRAFILER_AI_IMAGE_PRIMARY=mistral:mistral-medium-latest
PROCRAFILER_AI_IMAGE_FALLBACK=

# Reserved for later — not consulted by the current code:
# PDF readable files are read locally (pypdf), so no PDF AI task is needed today.
PROCRAFILER_AI_PDF_PRIMARY=
PROCRAFILER_AI_PDF_FALLBACK=
# SUPERVISOR (optional AI control pass) — not implemented yet.
PROCRAFILER_AI_SUPERVISOR_PRIMARY=
PROCRAFILER_AI_SUPERVISOR_FALLBACK=
# VIDEO / audio analysis — planned for a later phase.
PROCRAFILER_AI_VIDEO_PRIMARY=
PROCRAFILER_AI_VIDEO_FALLBACK=

# Retry and timeout defaults (seconds)
PROCRAFILER_AI_TIMEOUT=60
PROCRAFILER_AI_RETRIES=2

# Optional task-specific overrides
PROCRAFILER_AI_ANALYSIS_TIMEOUT=60
PROCRAFILER_AI_ANALYSIS_RETRIES=2

# Mistral API key (required when any chain uses the mistral provider)
MISTRAL_API_KEY=
