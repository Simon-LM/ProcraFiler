# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# IDE/OS
.vscode/
.idea/
.DS_Store
.directory

# Secrets (never commit runtime env files or keys)
*.env
!.env.example
# intentionally-empty test fixture (offline guard), not a secret
!tests/empty.env
*.key
*.pem

# User context file (personal data — only the .example template is committed)
context.txt
context.md

# ProcraFiler runtime artifacts
runtime/
logs/
history/

# Dev sandbox: the RUNNER + synthetic samples are versioned (a test feature);
# only the generated runtime workspace (library/mirror/state) is ignored.
sandbox/workspace/

# Private working data — never committed (test photos, sandbox runs, real documents)
private/
